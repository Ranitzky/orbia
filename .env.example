# Unraid defaults. Create this directory and give PUID:PGID write access first.
ORBIA_DATA_DIR=/mnt/user/appdata/orbia
PUID=99
PGID=100
ORBIA_BIND=0.0.0.0
ORBIA_PORT=8080

# Set to the exact browser origin behind a reverse proxy, without a trailing /.
# Example: https://orbia.example.com
ORBIA_ORIGIN=
# Set true when users access Orbia over HTTPS. Leave false for local HTTP.
ORBIA_SECURE_COOKIE=false

# Optional sample bookmarks. Only inserts when the bookmark database is empty.
ORBIA_SEED_DEMO=false
